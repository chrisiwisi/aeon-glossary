{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular: Serve on local network",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start",
      "cwd": "${workspaceFolder}/Client"
    },
    {
      "name": "Firebase: Emulators",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run emulators",
      "cwd": "${workspaceFolder}/Client"
    },
    {
      "name": "Firebase: Sync technology cache (emulator)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run sync:technology:emulator",
      "cwd": "${workspaceFolder}/Client",
      "env": {
        "FIREBASE_DATABASE_EMULATOR_HOST": "127.0.0.1:9000"
      }
    }
  ],
  "compounds": [
    {
      "name": "Angular + Firebase emulators",
      "configurations": [
        "Angular: Serve on local network",
        "Firebase: Emulators"
      ],
      "stopAll": true
    }
  ]
}
