{
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "database": {
      "port": 9000
    },
    "ui": {
      "enabled": true,
      "port": 9001
    }
  },
  "database": {
    "rules": "database.rules.json"
  }
}
