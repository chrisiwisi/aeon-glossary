{
  "hosting": {
    "public": "docs",
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR\" run build -- --configuration production"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "database": {
      "port": 9000,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 9001
    },
    "functions": {
      "port": 5001
    },
    "pubsub": {
      "port": 8085
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    },
    {
      "source": "RulesTableConverter",
      "codebase": "glossary",
      "runtime": "python312",
      "ignore": [
        "venv",
        "__pycache__",
        "*.pyc",
        "test_*.py"
      ]
    }
  ]
}
